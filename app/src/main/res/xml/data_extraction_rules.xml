<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="library.json"/>
        <exclude domain="file" path="downloaded_ebooks"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="library.json"/>
        <include domain="file" path="covers"/>
        <include domain="file" path="downloaded_ebooks"/>
    </device-transfer>
</data-extraction-rules>